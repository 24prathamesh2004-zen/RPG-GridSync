# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me
LOG_LEVEL=INFO
# Required in staging/production (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://__APP_NAME__-fe.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./gridsync.db

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Market data and recommendations ───────────────────────────────────────────
ENERGYMAP_API_KEY=
DAILY_RECOMMENDATION_ENABLED=true
DAILY_RECOMMENDATION_TIME=06:30

# ── GridSync scoring weights ───────────────────────────────────────────────────
GRIDSYNC_WEIGHT_PRICE=0.50
GRIDSYNC_WEIGHT_CARBON=0.30
GRIDSYNC_WEIGHT_CAPTIVE=0.20
